{
  "name": "wp-homepage-agent",
  "version": "0.2.0",
  "private": true,
  "description": "Local-first WordPress homepage generation and approval agent",
  "type": "module",
  "engines": { "node": ">=20.0.0" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "validate": "npm run build && npm run lint",
    "homepage:once": "tsx src/cli/main.ts once",
    "homepage:worker": "tsx src/cli/main.ts worker",
    "homepage:dry-run": "tsx src/cli/main.ts dry-run",
    "homepage:status": "tsx src/cli/main.ts status",
    "homepage:reconcile": "tsx src/cli/main.ts reconcile",
    "homepage:retry": "tsx src/cli/main.ts retry",
    "lmstudio:check": "tsx src/cli/lmstudio-check.ts",
    "lmstudio:smoke": "tsx src/cli/lmstudio-smoke.ts",
    "relay": "tsx src/cli/relay.ts",
    "tracker:create": "tsx scripts/create-tracker.ts",
    "audit:dependencies": "node scripts/audit-dependencies.mjs"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "htmlparser2": "^10.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.17.0",
    "eslint": "^9.32.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0"
  }
}
