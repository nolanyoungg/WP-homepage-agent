# LM Studio's OpenAI-compatible local HTTP endpoint. This must point to an
# LM Studio or LM Link server reachable from GRASS10; no cloud API is used.
LMSTUDIO_BASE_URL=http://192.168.1.35:1234

# Exact identifier returned by LM Studio's GET /v1/models endpoint. The worker
# checks that this model is already available and never downloads a model.
# Planning and per-section HTML generation use LM Studio Chat Completions only;
# there is no provider fallback, fake inference layer, or separate cloud flag.
LMSTUDIO_PRIMARY_MODEL=openai/gpt-oss-20b

# Repository-relative or absolute path to the Excel work queue. The workbook
# must contain the worksheet named "Homepage tracker" and the required columns.
TRACKER_PATH=manual-files/wordpress-homepage-tracker.xlsx

# WordPress document root for the designated Local sandbox. WP-CLI commands are
# always scoped to this installation.
LOCAL_WORDPRESS_ROOT=C:\Users\NolanYoung\Local Sites\7-20-wp-playground\app\public

# The only theme directory the worker may modify. The worker requires this exact
# nolan-young-theme-template-02 path and rejects every other theme directory.
THEME_PATH=C:\Users\NolanYoung\Local Sites\7-20-wp-playground\app\public\wp-content\themes\nolan-young-theme-template-02

# Base URL displayed by Local after its Live Link is enabled. Enter only the
# site origin; the worker appends the generated preview Page path.
LIVE_LINK_URL=https://your-live-link.localsite.io

# Local Live Link access credentials. These are read only from .env, used in
# memory for reachability checks and the approval message, and never persisted
# to the workbook, manifest, generated PHP, source logs, or Git.
LIVE_LINK_USERNAME=put-local-live-link-username-here
LIVE_LINK_PASSWORD=put-local-live-link-password-here

# Authenticated macOS relay base URL reachable from GRASS10. The minimal relay
# listens on port 8787 by default. Use a trusted LAN/VPN or TLS reverse proxy;
# never expose its plain HTTP listener directly to the public internet.
IMESSAGE_RELAY_URL=http://your-mac-lan-ip:8787

# Shared bearer token generated on the Mac, preferably with:
# openssl rand -hex 32
# Store the real value only in .env on GRASS10 and the Mac environment.
IMESSAGE_RELAY_TOKEN=put-a-random-relay-bearer-token-here

# Exact Messages handle authorized to receive the request and send the reply.
# Prefer an E.164 phone number (country code plus digits), such as +15551234567.
# Sender matching is exact; differently formatted numbers are rejected.
IMESSAGE_RECIPIENT=+15551234567



