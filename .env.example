# LM Studio 0.4.8+ native/OpenAI-compatible API. Use 127.0.0.1 in LM Link
# mode. For direct-LAN mode, use the private address of the LM Studio server.
LMSTUDIO_BASE_URL=http://127.0.0.1:1234
LMSTUDIO_API_TOKEN=
LMSTUDIO_PRIMARY_MODEL=openai/gpt-oss-20b
LMSTUDIO_FALLBACK_MODELS=
LMSTUDIO_CONNECTION_MODE=direct-lan
LMSTUDIO_MODEL_POLICY=required-loaded
LMSTUDIO_REASONING=low
LMSTUDIO_MIN_VERSION=0.4.8
LMSTUDIO_CONFIRMED_VERSION=0.4.8
LMSTUDIO_HEALTH_TIMEOUT_MS=10000
LMSTUDIO_MODEL_LOAD_TIMEOUT_MS=180000
LMSTUDIO_PLAN_TIMEOUT_MS=180000
LMSTUDIO_SECTION_TIMEOUT_MS=300000
LMSTUDIO_RETRY_LIMIT=1
LMSTUDIO_RETRY_BASE_DELAY_MS=500
LMSTUDIO_SEED=42
LMSTUDIO_PLAN_MAX_TOKENS=4000
LMSTUDIO_SECTION_MAX_TOKENS=4000
LMSTUDIO_STRUCTURED_PLAN=false
LMSTUDIO_GENERATION_CONCURRENCY=1

# Tracker and the designated Local WordPress installation.
TRACKER_PATH=manual-files/wordpress-homepage-tracker.xlsx
LOCAL_WORDPRESS_ROOT=C:/Users/YourName/Local Sites/example-site/app/public
THEME_PATH=C:/Users/YourName/Local Sites/example-site/app/public/wp-content/themes/nolan-young-theme-template-02
LIVE_LINK_URL=https://example-live-link.localsite.io
LIVE_LINK_USERNAME=replace-with-live-link-username
LIVE_LINK_PASSWORD=replace-with-live-link-password

# Messaging mode: relay (Windows-to-Mac), macos (direct on Mac), or dry-run
# (no send and no approval reply).
IMESSAGE_ADAPTER=relay
IMESSAGE_RELAY_URL=http://mac-relay.internal:8787
IMESSAGE_RELAY_TOKEN=replace-with-at-least-24-random-characters
IMESSAGE_RECIPIENT=+15551234567
IMESSAGE_RELAY_TIMEOUT_MS=30000
IMESSAGE_RELAY_LISTEN_HOST=127.0.0.1
IMESSAGE_RELAY_LISTEN_PORT=8787
IMESSAGE_RELAY_DATA_DIR=relay-data
IMESSAGE_CHAT_DB=~/Library/Messages/chat.db
IMESSAGE_INCLUDE_LIVE_LINK_PASSWORD=false

# Worker cadence, lock recovery, checkpoints, and structured run logs.
POLL_INTERVAL_MS=60000
IDLE_BACKOFF_MS=60000
PREFLIGHT_CACHE_MS=30000
TRACKER_LOCK_STALE_MS=900000
CHECKPOINT_MAX_AGE_MS=604800000
RUN_LOGS_DIR=data/runs
HOMEPAGE_DATA_DIR=data/homepages
